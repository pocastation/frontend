# 비워 두면 로컬은 next.config의 rewrite로 같은 출처(:3000)에서 백엔드를 프록시한다.
# 쿠키가 1st-party가 되고 CORS가 발생하지 않는다 — 로컬 개발은 이 상태가 기본이다.
# staging 백엔드에 직접 붙이려면 그 주소를 넣는다(그 경우 프록시를 지나가지 않는다).
# 배포(Vercel)에서는 반드시 지정해야 한다 — 없으면 프로덕션 빌드가 예외를 던진다.
NEXT_PUBLIC_API_URL=

# 프록시가 넘길 로컬 백엔드 주소(기본 http://localhost:8080). 포트를 바꿔 띄울 때만 쓴다.
# LOCAL_BACKEND_ORIGIN=http://localhost:8080
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# 본인인증 채널키(#386). 결제 채널키와 **다른 값**이다 — 결제는 갤럭시아, 본인인증은 다날이라
# 같은 스토어 안의 별개 채널이다. 포트원 콘솔 > 연동 정보 > 채널 관리 > 실연동에서 확인한다.
# 비워 두면 인증 버튼이 "준비하고 있어요" 문구만 보여준다(조용한 실패를 만들지 않는다).
NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=
